# Optional aisstream.io API key (supplements local RTL-SDR VHF AIS-catcher for outer NY Harbor)
AISSTREAM_API_KEY=

# Private ntfy.sh topic for 24/7 OBS camera freeze & recovery push notifications
# Pick a random unguessable string, e.g. my-hudson-cam-9f8e7d6c, and subscribe in the ntfy app
NTFY_TOPIC=

# Optional overrides (defaults work automatically on the Mac mini)
# OBS_URL=obs://127.0.0.1:4455
# AIS_CATCHER_URL=http://127.0.0.1:8100/api/v1/vessels?limit=250&max_age_s=300
# PORT=8765

# Optional physical optical PTZ camera drivers (VISCA-over-IP or Axis VAPIX)
# PTZ_FOMAKO_IP=192.168.1.50
# PTZ_VISCA_IP=192.168.1.50
# PTZ_VISCA_PORT=52381
# PTZ_AXIS_IP=192.168.1.60
# PTZ_AXIS_USER=root
# PTZ_AXIS_PASS=
