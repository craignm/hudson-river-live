# Optional aisstream.io API key (supplements local RTL-SDR VHF AIS-catcher for outer NY Harbor)
AISSTREAM_API_KEY=

# Private ntfy.sh topic for 24/7 OBS camera freeze & recovery push notifications
# Pick a random unguessable string, e.g. my-hudson-cam-9f8e7d6c, and subscribe in the ntfy app
NTFY_TOPIC=

# Optional overrides (defaults work automatically on the Mac mini)
# OBS_URL=obs://127.0.0.1:4455
# AIS_CATCHER_URL=http://127.0.0.1:8100/api/v1/vessels?limit=250&max_age_s=300
# PORT=8765

# Sony SRG-A40 4K 30x PTZ camera (HTTP Digest CGI over Ethernet)
# SONY_PTZ_HOST=192.168.1.136
# SONY_PTZ_USER=admin
# SONY_PTZ_PASS=

# Optional 24/7 PTZ + Chyrons YouTube RTMPS stream key & Cloudflare Tunnel secret (/zoom)
# PTZ_YOUTUBE_STREAM_KEY=
# PTZ_TUNNEL_SECRET=

# Optional YouTube Data API v3 OAuth credentials for automated 3-hour 4K monthly VOD uploads
# (Populated automatically by running './Authorize Monthly YouTube Uploads.command')
# YT_OAUTH_CLIENT_ID=
# YT_OAUTH_CLIENT_SECRET=
# YT_OAUTH_REFRESH_TOKEN=
# YT_HUDSON_PLAYLIST_ID=

# Optional legacy physical optical PTZ camera drivers (VISCA-over-IP or Axis VAPIX)
# PTZ_FOMAKO_IP=192.168.1.50
# PTZ_VISCA_IP=192.168.1.50
# PTZ_VISCA_PORT=52381
# PTZ_AXIS_IP=192.168.1.60
# PTZ_AXIS_USER=root
# PTZ_AXIS_PASS=
